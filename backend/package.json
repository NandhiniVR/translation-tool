    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "22.16.3",
    "@types/uuid": "10.0.0",
    "docx": "^9.7.1",
    "form-data": "^4.0.6",
