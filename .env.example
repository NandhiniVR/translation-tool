# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Backend server port
PORT=3001

# Concurrency: number of segments to translate in parallel (start at 1)
TRANSLATION_CONCURRENCY=1

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Max retries for transient Gemini errors
GEMINI_MAX_RETRIES=3

# Uploads and outputs directories (relative to backend root)
UPLOADS_DIR=../uploads
OUTPUTS_DIR=../outputs

# Context: max characters for previous/next segments supplied to Gemini
CONTEXT_MAX_CHARS=500
