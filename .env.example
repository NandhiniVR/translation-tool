[TEMPLATE]
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Mistral ---
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Backend server port
PORT=3001

# Concurrency: number of segments to translate in parallel (start at 1)
TRANSLATION_CONCURRENCY=1

# Max retries for transient provider errors
GEMINI_MAX_RETRIES=3
GROQ_MAX_RETRIES=3
MISTRAL_MAX_RETRIES=3
OPENROUTER_MAX_RETRIES=3

# Optional default provider used when the frontend does not specify one
AI_PROVIDER=gemini

# Optional compatible API endpoint overrides (useful for regional/proxy deployments)
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Uploads and outputs directories (relative to backend root)
UPLOADS_DIR=../uploads
OUTPUTS_DIR=../outputs

# Context: max characters for previous/next segments supplied to the model
CONTEXT_MAX_CHARS=500
