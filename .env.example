[TEMPLATE]
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=Gemini 3.5 Flash

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Mistral ---
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Backend server port
PORT=3001

# --- Translation performance tuning ---
# Maximum segments per AI request. Token-aware batching packs as many segments
# as fit under TRANSLATION_MAX_BATCH_TOKENS, capped by this value — short
# segments pack densely, long segments are limited by the token budget.
# Batches are processed by a bounded worker pool (at most TRANSLATION_CONCURRENCY
# requests in flight at once) and results are always reassembled in original
# document order.
TRANSLATION_BATCH_SIZE=30

# Approximate token budget per AI request. 0 disables token-aware batching
# (falls back to fixed batchSize packing). Kept well below every provider's
# context window so responses have headroom too.
TRANSLATION_MAX_BATCH_TOKENS=12000

# When enabled (default), segments confidently written in a language OTHER than
# the selected source language are passed through unchanged WITHOUT being sent
# to the AI model. Huge speed win on multilingual documents (e.g. a Tamil+English
# file translated Tamil→English only sends the Tamil segments to the model).
TRANSLATION_FILTER_OTHER_LANGUAGES=true

# Number of batches processed concurrently (bounded worker pool). Safe range is
# 3-5 for Gemini/OpenRouter; Groq and Mistral tolerate higher values. Higher
# concurrency increases throughput but can hit provider rate limits (429s are
# auto-retried with backoff).
TRANSLATION_CONCURRENCY=4

# Optional stagger (ms) between batch starts. Default 0 — providers already
# back off on rate limits, so an unconditional pause only adds idle time on
# large documents. Set > 0 only if you need aggressive pacing.
# TRANSLATION_BATCH_DELAY_MS=0

# Provider-specific overrides. Different providers have different rate limits
# and optimal batch sizes; when set, these take precedence over the global
# values above. Unset values fall back to the global settings.
# GEMINI_BATCH_SIZE=30
# GEMINI_CONCURRENCY=4
# GEMINI_MAX_BATCH_TOKENS=12000
# GROQ_BATCH_SIZE=30
# GROQ_CONCURRENCY=8
# GROQ_MAX_BATCH_TOKENS=16000
# MISTRAL_BATCH_SIZE=30
# MISTRAL_CONCURRENCY=4
# MISTRAL_MAX_BATCH_TOKENS=12000
# OPENROUTER_BATCH_SIZE=20
# OPENROUTER_CONCURRENCY=3
# OPENROUTER_MAX_BATCH_TOKENS=12000

# Max retries for transient provider errors (permanent errors such as invalid
# API keys or auth failures fail immediately and are never retried)
GEMINI_MAX_RETRIES=3
GROQ_MAX_RETRIES=3
MISTRAL_MAX_RETRIES=3
OPENROUTER_MAX_RETRIES=3

# --- Rate limiting (Mistral / OpenRouter) ---
# HTTP 429 responses are retried with the server's Retry-After header (jittered)
# up to this dedicated budget, independent of MAX_RETRIES.
MISTRAL_RATE_LIMIT_MAX_RETRIES=4
OPENROUTER_RATE_LIMIT_MAX_RETRIES=4

# Provider-wide cap on concurrent in-flight requests (semaphore, shared across
# all jobs in the process). Keeps total load within the account's safe limit
# even when several translation jobs run at once.
MISTRAL_MAX_CONCURRENT=4
OPENROUTER_MAX_CONCURRENT=3

# --- Batch re-queue on rate limits ---
# When a batch's 429 budget is exhausted inside the provider (Retry-After +
# jittered backoff already applied there), the pipeline re-queues the SAME batch
# this many more times with its own jittered exponential backoff (base 1s,
# doubling, capped 30s) before the batch's segments are marked failed. Prevents
# temporary Mistral rate limits from turning a whole batch into failed segments.
TRANSLATION_BATCH_RATE_LIMIT_RETRIES=3

# Optional default provider used when the frontend does not specify one
AI_PROVIDER=gemini

# Optional compatible API endpoint overrides (useful for regional/proxy deployments)
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Uploads and outputs directories (relative to backend root)
UPLOADS_DIR=../uploads
OUTPUTS_DIR=../outputs

# Context: max characters for previous/next segments supplied to the model
CONTEXT_MAX_CHARS=500
